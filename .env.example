# ─── Database ────────────────────────────────────────────────────────────────
# Async PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://queuecrm:queuecrm@localhost:5432/queuecrm

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis connection string (used for queue sorted sets, pub/sub, refresh token whitelist)
REDIS_URL=redis://localhost:6379/0

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Strong random secret — generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token lifetime in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── 360dialog WhatsApp API ───────────────────────────────────────────────────
# Base URL for 360dialog On-Premise API
D360_API_URL=https://waba.360dialog.io/v1
# Partner-level token (shared across all tenants)
D360_PARTNER_TOKEN=your_partner_token_here

# ─── Webhook ─────────────────────────────────────────────────────────────────
# Secret path segment for the WhatsApp webhook endpoint (acts as a simple token)
WEBHOOK_SECRET_PATH=your_secret_webhook_path

# ─── Application ─────────────────────────────────────────────────────────────
# Public URL of the backend (used for QR codes, links in notifications, etc.)
PUBLIC_APP_URL=https://api.yourapp.com

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (JSON array string)
# localhost:5173 is always included automatically
ALLOWED_ORIGINS=["https://app.yourapp.com","https://admin.yourapp.com"]
