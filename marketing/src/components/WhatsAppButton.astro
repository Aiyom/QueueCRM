---
import { rtlLangs, type Lang, type Translations } from '../i18n'

interface Props { lang: Lang; t: Translations }
const { lang, t } = Astro.props
const isRTL = rtlLangs.includes(lang)
const waNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '966501234567'
const waMsg = encodeURIComponent(
  lang === 'ar' ? 'أريد معرفة المزيد عن QueueCRM' :
  lang === 'ru' ? 'Хочу узнать о QueueCRM' : 'I want to learn about QueueCRM'
)
---

<a
  href={`https://wa.me/${waNumber}?text=${waMsg}`}
  target="_blank"
  rel="noopener"
  title={t.whatsappButton}
  class={`fixed bottom-6 z-50 group flex items-center gap-0 hover:gap-2 overflow-hidden rounded-full shadow-xl shadow-green-300/40 transition-all duration-300 ${isRTL ? 'left-6' : 'right-6'}`}
  style="background-color: #25D366;"
>
  <!-- Icon always visible -->
  <div class="w-14 h-14 flex items-center justify-center shrink-0">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" class="w-7 h-7">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
      <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.118 1.528 5.851L.057 23.25a.75.75 0 00.914.914l5.4-1.471A11.943 11.943 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.907 0-3.693-.502-5.241-1.381l-.375-.214-3.886 1.059 1.059-3.887-.214-.374A9.964 9.964 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
    </svg>
  </div>
  <!-- Label expands on hover -->
  <span class="text-white text-sm font-semibold pr-0 max-w-0 group-hover:max-w-xs group-hover:pr-4 transition-all duration-300 overflow-hidden whitespace-nowrap">
    {t.whatsappButton}
  </span>
</a>
