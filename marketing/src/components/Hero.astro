---
import { rtlLangs, type Lang, type Translations } from '../i18n'

interface Props { lang: Lang; t: Translations }
const { lang, t } = Astro.props
const isRTL = rtlLangs.includes(lang)
const dashboardUrl = import.meta.env.PUBLIC_DASHBOARD_URL || 'https://app.qcrm.sa'

const waMsg1 = lang === 'ar' ? 'أهلاً! كيف أساعدك؟' : lang === 'ru' ? 'Привет! Выберите услугу:' : 'Hello! Choose a service:'
const waMsg2 = lang === 'ar' ? '1️⃣ غسيل سيارة\n2️⃣ تغيير زيت\n3️⃣ فحص شامل' : lang === 'ru' ? '1️⃣ Мойка\n2️⃣ Замена масла\n3️⃣ Диагностика' : '1️⃣ Car wash\n2️⃣ Oil change\n3️⃣ Full check'
const waMsg3 = lang === 'ar' ? '1' : '1'
const waMsg4 = lang === 'ar' ? '✅ أنت في الطابور!\nموقعك: #3\nالوقت المتوقع: ~20 دقيقة' : lang === 'ru' ? '✅ Вы в очереди!\nПозиция: #3\nОжидание: ~20 мин' : '✅ You\'re in queue!\nPosition: #3\nETA: ~20 min'
const waMsg5 = lang === 'ar' ? '🔔 دورك بعد دقيقتين! تعال الآن' : lang === 'ru' ? '🔔 Вы следующий! Подъезжайте' : '🔔 You\'re next! Come now'
---

<!-- Hero -->
<section class="relative overflow-hidden bg-gradient-to-br from-indigo-950 via-indigo-900 to-violet-900 grad-animate text-white">
  <!-- Background decorations -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-violet-600/20 rounded-full blur-3xl float-slow"></div>
    <div class="absolute -bottom-20 -left-20 w-80 h-80 bg-indigo-400/15 rounded-full blur-3xl float"></div>
    <div class="absolute top-1/2 left-1/2 w-64 h-64 bg-purple-500/10 rounded-full blur-2xl float-delay"></div>
    <!-- Grid pattern -->
    <svg class="absolute inset-0 w-full h-full opacity-5" xmlns="http://www.w3.org/2000/svg">
      <defs><pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="white" stroke-width="0.5"/>
      </pattern></defs>
      <rect width="100%" height="100%" fill="url(#grid)"/>
    </svg>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-20 lg:py-28">
    <div class={`flex flex-col lg:flex-row items-center gap-12 ${isRTL ? 'lg:flex-row-reverse' : ''}`}>

      <!-- Left: text -->
      <div class={`flex-1 text-center ${isRTL ? 'lg:text-right' : 'lg:text-left'}`}>
        <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 backdrop-blur rounded-full px-4 py-1.5 text-sm font-medium mb-6 reveal">
          <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
          {t.hero.badge}
        </div>

        <h1 class={`text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight mb-5 reveal reveal-delay-1 ${lang === 'ar' ? 'leading-snug' : ''}`}>
          {t.hero.headline}
        </h1>

        <p class="text-indigo-200 text-lg sm:text-xl leading-relaxed mb-8 max-w-xl mx-auto lg:mx-0 reveal reveal-delay-2">
          {t.hero.subheadline}
        </p>

        <div class={`flex flex-col sm:flex-row gap-3 mb-12 justify-center ${isRTL ? 'lg:justify-end sm:flex-row-reverse' : 'lg:justify-start'} reveal reveal-delay-3`}>
          <a
            href={`${dashboardUrl}/login`}
            class="inline-flex items-center justify-center gap-2 bg-white text-indigo-700 font-bold px-7 py-3.5 rounded-full shadow-xl hover:shadow-white/20 hover:bg-indigo-50 transition-all"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 1.414L10.586 9H7a1 1 0 100 2h3.586l-1.293 1.293a1 1 0 101.414 1.414l3-3a1 1 0 000-1.414z" clip-rule="evenodd"/>
            </svg>
            {t.hero.cta}
          </a>
          <a
            href="#how-it-works"
            class="inline-flex items-center justify-center gap-2 border border-white/30 text-white font-semibold px-7 py-3.5 rounded-full hover:bg-white/10 transition"
          >
            {t.hero.ctaSecondary}
          </a>
        </div>

        <!-- Stats -->
        <div class={`grid grid-cols-3 gap-4 reveal reveal-delay-4`}>
          {[
            { v: t.hero.stat1, l: t.hero.stat1label },
            { v: t.hero.stat2, l: t.hero.stat2label },
            { v: t.hero.stat3, l: t.hero.stat3label },
          ].map(({ v, l }) => (
            <div class="bg-white/10 border border-white/15 backdrop-blur rounded-2xl p-3 text-center">
              <p class="text-2xl font-extrabold text-white">{v}</p>
              <p class="text-indigo-300 text-xs mt-0.5 leading-tight">{l}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: phone mockup -->
      <div class="flex-shrink-0 reveal reveal-delay-2">
        <div class="relative">
          <!-- Glow behind phone -->
          <div class="absolute inset-0 bg-indigo-400/30 blur-3xl rounded-full scale-75 -translate-y-4"></div>

          <!-- Phone -->
          <div class="relative w-64 bg-gray-900 phone-frame overflow-hidden">
            <!-- Status bar -->
            <div class="bg-gray-800 px-4 pt-3 pb-1 flex items-center justify-between">
              <span class="text-white text-xs font-medium">9:41</span>
              <div class="flex gap-1 items-center">
                <div class="flex gap-0.5">
                  {[3,4,5].map(h => <div class={`w-1 bg-white rounded-sm`} style={`height:${h*2}px`}></div>)}
                </div>
                <svg class="w-3 h-3 text-white ms-1" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M17.778 8.222c-4.296-4.296-11.26-4.296-15.556 0A1 1 0 01.808 6.808c5.076-5.077 13.308-5.077 18.384 0a1 1 0 01-1.414 1.414zM14.95 11.05a7 7 0 00-9.9 0 1 1 0 01-1.414-1.414 9 9 0 0112.728 0 1 1 0 01-1.414 1.414zM12.12 13.88a3 3 0 00-4.242 0 1 1 0 01-1.415-1.415 5 5 0 017.072 0 1 1 0 01-1.415 1.415zM9 16a1 1 0 112 0 1 1 0 01-2 0z" clip-rule="evenodd"/>
                </svg>
                <svg class="w-3.5 h-3.5 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 4a2 2 0 012-2h12a2 2 0 012 2v2H2V4zM2 8h16v8a2 2 0 01-2 2H4a2 2 0 01-2-2V8z"/>
                </svg>
              </div>
            </div>

            <!-- WhatsApp header -->
            <div class="bg-green-600 px-3 py-2 flex items-center gap-2">
              <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center text-sm">🚗</div>
              <div>
                <p class="text-white text-xs font-semibold">Al-Noor Auto</p>
                <p class="text-green-200 text-xs">online</p>
              </div>
            </div>

            <!-- Chat -->
            <div class="bg-[#e5ddd5] px-3 py-3 space-y-2 min-h-[360px]"
                 style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2260%22 height=%2260%22><text x=%2210%22 y=%2230%22 opacity=%220.04%22 font-size=%2220%22>🚗</text></svg>')">

              <!-- Bot msg 1 -->
              <div class="bubble bubble-d1 flex justify-start">
                <div class="bg-white rounded-lg rounded-tl-none px-3 py-2 max-w-[85%] shadow-sm">
                  <p class="text-gray-800 text-xs leading-relaxed whitespace-pre-line">{waMsg2}</p>
                  <p class="text-gray-400 text-right text-[10px] mt-1">09:32</p>
                </div>
              </div>

              <!-- User reply -->
              <div class="bubble bubble-d2 flex justify-end">
                <div class="bg-green-100 rounded-lg rounded-tr-none px-3 py-2 shadow-sm">
                  <p class="text-gray-800 text-xs font-medium">1️⃣</p>
                  <p class="text-gray-400 text-right text-[10px] mt-1">09:32 ✓✓</p>
                </div>
              </div>

              <!-- Queue confirmation -->
              <div class="bubble bubble-d3 flex justify-start">
                <div class="bg-white rounded-lg rounded-tl-none px-3 py-2 max-w-[85%] shadow-sm">
                  <p class="text-gray-800 text-xs whitespace-pre-line leading-relaxed">{waMsg4}</p>
                  <p class="text-gray-400 text-right text-[10px] mt-1">09:32</p>
                </div>
              </div>

              <!-- Notification -->
              <div class="bubble bubble-d4 flex justify-start">
                <div class="bg-indigo-50 border border-indigo-100 rounded-lg rounded-tl-none px-3 py-2 max-w-[85%] shadow-sm">
                  <p class="text-indigo-800 text-xs font-medium">{waMsg5}</p>
                  <p class="text-indigo-400 text-right text-[10px] mt-1">09:51</p>
                </div>
              </div>
            </div>

            <!-- WhatsApp input bar -->
            <div class="bg-gray-100 px-2 py-2 flex items-center gap-1.5">
              <div class="flex-1 bg-white rounded-full px-3 py-1.5 text-xs text-gray-400">Message...</div>
              <div class="w-7 h-7 bg-green-500 rounded-full flex items-center justify-center">
                <svg class="w-3.5 h-3.5 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"/>
                </svg>
              </div>
            </div>
          </div>

          <!-- Floating badges -->
          <div class="absolute -right-4 top-16 bg-white rounded-xl shadow-xl px-3 py-2 text-xs font-semibold text-green-700 flex items-center gap-1.5 float">
            <span class="w-2 h-2 bg-green-500 rounded-full"></span>
            {lang === 'ar' ? '12 في الطابور' : lang === 'ru' ? '12 в очереди' : '12 in queue'}
          </div>
          <div class="absolute -left-6 bottom-20 bg-white rounded-xl shadow-xl px-3 py-2 text-xs font-bold text-indigo-700 float-delay">
            ⏱ ~20 {lang === 'ar' ? 'دقيقة' : lang === 'ru' ? 'мин' : 'min'}
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Wave divider -->
  <div class="absolute bottom-0 inset-x-0">
    <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" class="w-full h-12 md:h-16">
      <path d="M0 60L48 51.5C96 43 192 26 288 21.2C384 16.3 480 22.7 576 30.5C672 38.3 768 47.7 864 46.2C960 44.7 1056 32.3 1152 24C1248 15.7 1344 11.3 1392 9.2L1440 7V60H1392C1344 60 1248 60 1152 60C1056 60 960 60 864 60C768 60 672 60 576 60C480 60 384 60 288 60C192 60 96 60 48 60H0Z" fill="white"/>
    </svg>
  </div>
</section>

<!-- Problem section -->
<section class="py-20 px-4 sm:px-6 bg-white">
  <div class="max-w-5xl mx-auto">
    <div class={`text-center mb-12 reveal`}>
      <p class="text-indigo-600 font-semibold text-sm uppercase tracking-widest mb-2">
        {lang === 'ar' ? 'المشكلة' : lang === 'ru' ? 'Проблема' : 'The Problem'}
      </p>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900">{t.problem.title}</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {[t.problem.item1, t.problem.item2, t.problem.item3, t.problem.item4].map((item, i) => (
        <div class={`reveal reveal-delay-${i + 1} group flex items-start gap-4 p-5 rounded-2xl border-2 border-red-100 bg-red-50 hover:border-red-200 hover:bg-red-100/50 transition-all ${isRTL ? 'flex-row-reverse text-right' : ''}`}>
          <div class="w-10 h-10 rounded-xl bg-red-100 border border-red-200 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </div>
          <p class="text-gray-700 font-medium leading-snug pt-1.5">{item}</p>
        </div>
      ))}
    </div>
  </div>
</section>
