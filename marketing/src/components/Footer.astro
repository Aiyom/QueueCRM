---
import { rtlLangs, type Lang, type Translations } from '../i18n'

interface Props { lang: Lang; t: Translations }
const { lang, t } = Astro.props
const isRTL = rtlLangs.includes(lang)
const waNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '966501234567'
const waMsg = encodeURIComponent(
  lang === 'ar' ? 'أريد معرفة المزيد عن QueueCRM' :
  lang === 'ru' ? 'Хочу узнать о QueueCRM' : 'I want to learn about QueueCRM'
)
const dashboardUrl = import.meta.env.PUBLIC_DASHBOARD_URL || 'https://app.qcrm.sa'
---

<!-- CTA Banner -->
<section class="py-20 px-4 sm:px-6 bg-gradient-to-br from-indigo-600 via-indigo-700 to-violet-700 relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 right-0 w-72 h-72 bg-white/5 rounded-full blur-2xl"></div>
    <div class="absolute bottom-0 left-0 w-56 h-56 bg-violet-400/10 rounded-full blur-2xl"></div>
  </div>
  <div class="relative max-w-3xl mx-auto text-center text-white reveal">
    <h2 class="text-3xl sm:text-4xl font-extrabold mb-4">
      {lang === 'ar' ? 'جاهز للبدء؟' : lang === 'ru' ? 'Готов начать?' : 'Ready to get started?'}
    </h2>
    <p class="text-indigo-200 text-lg mb-8">
      {lang === 'ar' ? '30 يوماً مجاناً — بدون بطاقة ائتمان — إعداد في 30 دقيقة' :
       lang === 'ru' ? '30 дней бесплатно — без карты — запуск за 30 минут' :
       '30 days free — no credit card — setup in 30 minutes'}
    </p>
    <div class={`flex flex-col sm:flex-row gap-3 justify-center ${isRTL ? 'sm:flex-row-reverse' : ''}`}>
      <a
        href={`${dashboardUrl}/login`}
        class="inline-flex items-center justify-center gap-2 bg-white text-indigo-700 font-bold px-8 py-4 rounded-full shadow-xl hover:shadow-white/20 hover:bg-indigo-50 transition-all text-base"
      >
        🚀 {t.nav.startTrial}
      </a>
      <a
        href={`https://wa.me/${waNumber}?text=${waMsg}`}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center gap-2 border-2 border-white/30 text-white font-semibold px-8 py-4 rounded-full hover:bg-white/10 transition text-base"
      >
        💬 {t.footer.contact}
      </a>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="bg-gray-950 text-gray-400 py-12 px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    <div class={`flex flex-col md:flex-row items-start justify-between gap-8 mb-10 ${isRTL ? 'md:flex-row-reverse' : ''}`}>
      <!-- Brand -->
      <div class={isRTL ? 'text-right' : ''}>
        <div class={`flex items-center gap-2 mb-3 ${isRTL ? 'flex-row-reverse' : ''}`}>
          <div class="w-8 h-8 bg-gradient-to-br from-indigo-500 to-violet-600 rounded-xl flex items-center justify-center">
            <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 5a2 2 0 012-2h7a2 2 0 012 2v4a2 2 0 01-2 2H9l-3 3v-3H4a2 2 0 01-2-2V5z"/>
            </svg>
          </div>
          <span class="font-bold text-white text-lg">QueueCRM</span>
        </div>
        <p class="text-sm max-w-xs leading-relaxed">{t.footer.tagline}</p>
      </div>

      <!-- Links -->
      <div class={`flex gap-12 text-sm ${isRTL ? 'flex-row-reverse' : ''}`}>
        <div>
          <p class="text-white font-semibold mb-3">Product</p>
          <div class="space-y-2">
            <a href="#how-it-works" class="block hover:text-white transition">{t.nav.howItWorks}</a>
            <a href="#pricing" class="block hover:text-white transition">{t.nav.pricing}</a>
          </div>
        </div>
        <div>
          <p class="text-white font-semibold mb-3">{t.footer.contact}</p>
          <div class="space-y-2">
            <a href={`https://wa.me/${waNumber}?text=${waMsg}`} target="_blank" rel="noopener" class="block hover:text-green-400 transition">
              {t.footer.whatsapp}
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class={`border-t border-gray-800 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs ${isRTL ? 'sm:flex-row-reverse' : ''}`}>
      <p>© {new Date().getFullYear()} QueueCRM. {t.footer.rights}</p>
      <div class="flex gap-4">
        {(['ar','en','ru'] as const).map(l => (
          <a
            href={`/${l}/`}
            class={`hover:text-white transition ${lang === l ? 'text-white font-semibold' : ''}`}
          >
            {l.toUpperCase()}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
