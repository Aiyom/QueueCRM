---
import { rtlLangs, type Lang, type Translations } from '../i18n'

interface Props { lang: Lang; t: Translations }
const { lang, t } = Astro.props
const isRTL = rtlLangs.includes(lang)
---

<section id="faq" class="py-24 px-4 sm:px-6 bg-white">
  <div class="max-w-3xl mx-auto">
    <div class="text-center mb-14 reveal">
      <p class="text-indigo-600 font-semibold text-sm uppercase tracking-widest mb-2">FAQ</p>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900">{t.faq.title}</h2>
    </div>

    <div class="space-y-3">
      {t.faq.items.map(({ q, a }: { q: string; a: string }, i: number) => (
        <details class={`reveal reveal-delay-${(i % 3) + 1} group bg-gray-50 border border-gray-200 rounded-2xl overflow-hidden hover:border-indigo-200 transition-colors`}>
          <summary class={`flex items-center justify-between p-5 cursor-pointer font-semibold text-gray-800 hover:text-indigo-700 transition-colors list-none gap-4 ${isRTL ? 'flex-row-reverse' : ''}`}>
            <span class={`flex items-center gap-3 ${isRTL ? 'flex-row-reverse' : ''}`}>
              <span class="w-7 h-7 rounded-full bg-indigo-100 text-indigo-600 text-xs font-bold flex items-center justify-center shrink-0">
                {i + 1}
              </span>
              {q}
            </span>
            <svg
              class="w-5 h-5 text-gray-400 group-open:text-indigo-500 group-open:rotate-180 transition-all shrink-0"
              fill="none" stroke="currentColor" viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <div class={`px-5 pb-5 pt-0 text-gray-600 leading-relaxed border-t border-gray-200 ${isRTL ? 'text-right' : ''}`}>
            <p class="pt-4">{a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
