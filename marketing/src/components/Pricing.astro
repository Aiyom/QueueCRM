---
import { rtlLangs, type Lang, type Translations } from '../i18n'

interface Props { lang: Lang; t: Translations }
const { lang, t } = Astro.props
const isRTL = rtlLangs.includes(lang)
const dashboardUrl = import.meta.env.PUBLIC_DASHBOARD_URL || 'https://app.qcrm.sa'
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000'

// Fetch plans from API; fall back to hardcoded if backend unavailable
interface ApiPlan {
  id: string; slug: string
  name_en: string; name_ar: string | null; name_ru: string | null
  price_usd: number; features: string[] | null; sort_order: number
}

let apiPlans: ApiPlan[] = []
try {
  const res = await fetch(`${apiUrl}/api/v1/plans/`, { signal: AbortSignal.timeout(3000) })
  if (res.ok) apiPlans = await res.json()
} catch { /* backend offline — use fallback */ }

// SAR rate
const SAR = 3.75

// Map API plan → display object
function planName(p: ApiPlan) {
  if (lang === 'ar' && p.name_ar) return p.name_ar
  if (lang === 'ru' && p.name_ru) return p.name_ru
  return p.name_en
}

// Use API plans if available, otherwise use i18n fallback
const fallbackPlans = [
  { slug: 'starter', data: t.pricing.plans.starter },
  { slug: 'pro',     data: t.pricing.plans.pro },
  { slug: 'business',data: t.pricing.plans.business },
]

const displayPlans = apiPlans.length > 0
  ? apiPlans.map((p, i) => ({
      slug: p.slug,
      name: planName(p),
      priceUsd: p.price_usd,
      priceSAR: (p.price_usd * SAR).toFixed(0),
      features: p.features ?? [],
      highlight: i === 1, // middle plan is highlighted
    }))
  : fallbackPlans.map((fp, i) => ({
      slug: fp.slug,
      name: fp.data.name,
      priceUsd: parseFloat(fp.data.price),
      priceSAR: fp.data.priceSAR,
      features: fp.data.features as string[],
      highlight: i === 1,
    }))

const icons = ['🌱','⚡','🏢','💎','🚀']
const ctaText = lang === 'ar' ? 'ابدأ مجاناً' : lang === 'ru' ? 'Начать бесплатно' : 'Start free trial'
---

<section id="pricing" class="py-24 px-4 sm:px-6 bg-gray-50 relative overflow-hidden">
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-violet-100/50 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2 pointer-events-none"></div>

  <div class="relative max-w-5xl mx-auto">
    <div class="text-center mb-14 reveal">
      <p class="text-indigo-600 font-semibold text-sm uppercase tracking-widest mb-2">
        {lang === 'ar' ? 'التسعير' : lang === 'ru' ? 'Стоимость' : 'Pricing'}
      </p>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-3">{t.pricing.title}</h2>
      <p class="text-gray-500 text-lg">{t.pricing.subtitle}</p>
    </div>

    {/* ≤3 plans: grid; >3 plans: horizontal scroll */}
    {displayPlans.length <= 3 ? (
    <div class={`grid gap-6 items-center ${displayPlans.length === 3 ? 'grid-cols-1 md:grid-cols-3' : displayPlans.length === 2 ? 'grid-cols-1 md:grid-cols-2 max-w-2xl mx-auto' : 'grid-cols-1 max-w-sm mx-auto'}`}>
      {displayPlans.map((plan, i) => (
        <div class={`reveal reveal-delay-${Math.min(i + 1, 4)} relative flex flex-col rounded-3xl overflow-hidden ${
          plan.highlight
            ? 'bg-gradient-to-br from-indigo-600 to-violet-600 text-white shadow-2xl shadow-indigo-300/40 scale-105'
            : 'bg-white border border-gray-200 shadow-md'
        }`}>
          {plan.highlight && (
            <div class={`absolute top-4 ${isRTL ? 'left-4' : 'right-4'}`}>
              <span class="bg-yellow-400 text-yellow-900 text-xs font-bold px-2.5 py-1 rounded-full shadow">
                ⭐ {t.pricing.popular}
              </span>
            </div>
          )}

          <div class="p-7 flex-1">
            <div class="text-3xl mb-3">{icons[i] ?? '✨'}</div>
            <h3 class={`font-bold text-xl mb-5 ${plan.highlight ? 'text-white' : 'text-gray-900'}`}>{plan.name}</h3>

            <div class="mb-6">
              <div class="flex items-baseline gap-1.5">
                <span class={`text-4xl font-extrabold ${plan.highlight ? 'text-white' : 'text-gray-900'}`}>
                  {plan.priceSAR}
                </span>
                <span class={`text-sm font-semibold ${plan.highlight ? 'text-indigo-200' : 'text-gray-400'}`}>
                  {t.pricing.currency}
                </span>
                <span class={`text-sm ${plan.highlight ? 'text-indigo-200' : 'text-gray-400'}`}>
                  {t.pricing.perMonth}
                </span>
              </div>
              <p class={`text-xs mt-0.5 ${plan.highlight ? 'text-indigo-300' : 'text-gray-400'}`}>
                ≈ ${plan.priceUsd} USD
              </p>
            </div>

            <ul class="space-y-2.5 mb-7">
              {plan.features.map((f: string) => (
                <li class={`flex items-center gap-2.5 text-sm ${plan.highlight ? 'text-indigo-100' : 'text-gray-700'} ${isRTL ? 'flex-row-reverse' : ''}`}>
                  <div class={`w-5 h-5 rounded-full flex items-center justify-center shrink-0 ${plan.highlight ? 'bg-white/20' : 'bg-indigo-100'}`}>
                    <svg class={`w-3 h-3 ${plan.highlight ? 'text-white' : 'text-indigo-600'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  {f}
                </li>
              ))}
            </ul>
          </div>

          <div class="px-7 pb-7">
            <a
              href={`${dashboardUrl}/login`}
              class={`block text-center py-3 rounded-2xl text-sm font-bold transition-all ${
                plan.highlight
                  ? 'bg-white text-indigo-700 hover:bg-indigo-50'
                  : 'border-2 border-gray-200 text-gray-700 hover:border-indigo-400 hover:text-indigo-600'
              }`}
            >
              {ctaText}
            </a>
          </div>
        </div>
      ))}
    </div>
    ) : (
    /* >3 plans — horizontal scroll with arrow buttons */
    <div class="relative" id="pricing-scroll-wrap">
      {/* Left arrow */}
      <button
        id="scroll-left"
        class={`hidden md:flex absolute ${isRTL ? '-right-5' : '-left-5'} top-1/2 -translate-y-1/2 z-10 w-10 h-10 bg-white border border-gray-200 rounded-full shadow-lg items-center justify-center text-gray-600 hover:text-indigo-600 hover:border-indigo-300 transition`}
        aria-label="scroll left"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>
      {/* Right arrow */}
      <button
        id="scroll-right"
        class={`hidden md:flex absolute ${isRTL ? '-left-5' : '-right-5'} top-1/2 -translate-y-1/2 z-10 w-10 h-10 bg-white border border-gray-200 rounded-full shadow-lg items-center justify-center text-gray-600 hover:text-indigo-600 hover:border-indigo-300 transition`}
        aria-label="scroll right"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>

      {/* Scrollable track */}
      <div
        id="pricing-track"
        class={`flex gap-5 overflow-x-auto snap-x snap-mandatory pb-4 scroll-smooth ${isRTL ? 'flex-row-reverse' : ''}`}
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        {displayPlans.map((plan, i) => (
          <div class={`snap-start shrink-0 w-72 relative flex flex-col rounded-3xl overflow-hidden ${
            plan.highlight
              ? 'bg-gradient-to-br from-indigo-600 to-violet-600 text-white shadow-2xl shadow-indigo-300/40'
              : 'bg-white border border-gray-200 shadow-md'
          }`}>
            {plan.highlight && (
              <div class={`absolute top-4 ${isRTL ? 'left-4' : 'right-4'}`}>
                <span class="bg-yellow-400 text-yellow-900 text-xs font-bold px-2.5 py-1 rounded-full shadow">
                  ⭐ {t.pricing.popular}
                </span>
              </div>
            )}
            <div class="p-6 flex-1">
              <div class="text-3xl mb-3">{icons[i] ?? '✨'}</div>
              <h3 class={`font-bold text-xl mb-5 ${plan.highlight ? 'text-white' : 'text-gray-900'}`}>{plan.name}</h3>
              <div class="mb-6">
                <div class="flex items-baseline gap-1.5">
                  <span class={`text-3xl font-extrabold ${plan.highlight ? 'text-white' : 'text-gray-900'}`}>{plan.priceSAR}</span>
                  <span class={`text-sm ${plan.highlight ? 'text-indigo-200' : 'text-gray-400'}`}>{t.pricing.currency} {t.pricing.perMonth}</span>
                </div>
                <p class={`text-xs mt-0.5 ${plan.highlight ? 'text-indigo-300' : 'text-gray-400'}`}>≈ ${plan.priceUsd} USD</p>
              </div>
              <ul class="space-y-2 mb-6">
                {plan.features.map((f: string) => (
                  <li class={`flex items-center gap-2 text-sm ${plan.highlight ? 'text-indigo-100' : 'text-gray-700'} ${isRTL ? 'flex-row-reverse' : ''}`}>
                    <div class={`w-4 h-4 rounded-full flex items-center justify-center shrink-0 ${plan.highlight ? 'bg-white/20' : 'bg-indigo-100'}`}>
                      <svg class={`w-2.5 h-2.5 ${plan.highlight ? 'text-white' : 'text-indigo-600'}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                      </svg>
                    </div>
                    {f}
                  </li>
                ))}
              </ul>
            </div>
            <div class="px-6 pb-6">
              <a href={`${dashboardUrl}/login`} class={`block text-center py-2.5 rounded-2xl text-sm font-bold transition-all ${plan.highlight ? 'bg-white text-indigo-700 hover:bg-indigo-50' : 'border-2 border-gray-200 text-gray-700 hover:border-indigo-400 hover:text-indigo-600'}`}>
                {ctaText}
              </a>
            </div>
          </div>
        ))}
      </div>

      {/* Scroll dots indicator */}
      <div class="flex justify-center gap-2 mt-4" id="scroll-dots">
        {displayPlans.map((_, i) => (
          <button
            class={`scroll-dot w-2 h-2 rounded-full transition-all ${i === 0 ? 'bg-indigo-600 w-6' : 'bg-gray-300'}`}
            data-index={i}
            aria-label={`Go to plan ${i + 1}`}
          ></button>
        ))}
      </div>
    </div>
    )}

    <script>
      const track = document.getElementById('pricing-track')
      const btnLeft = document.getElementById('scroll-left')
      const btnRight = document.getElementById('scroll-right')
      const dots = document.querySelectorAll('.scroll-dot')

      if (track && btnLeft && btnRight) {
        const cardWidth = 288 + 20 // w-72 + gap-5

        btnLeft.addEventListener('click', () => {
          track.scrollBy({ left: -cardWidth, behavior: 'smooth' })
        })
        btnRight.addEventListener('click', () => {
          track.scrollBy({ left: cardWidth, behavior: 'smooth' })
        })

        track.addEventListener('scroll', () => {
          const idx = Math.round(track.scrollLeft / cardWidth)
          dots.forEach((d, i) => {
            d.classList.toggle('bg-indigo-600', i === idx)
            d.classList.toggle('w-6', i === idx)
            d.classList.toggle('bg-gray-300', i !== idx)
            d.classList.toggle('w-2', i !== idx)
          })
        })

        dots.forEach((d) => {
          d.addEventListener('click', () => {
            const idx = parseInt((d as HTMLElement).dataset.index ?? '0')
            track.scrollTo({ left: idx * cardWidth, behavior: 'smooth' })
          })
        })
      }
    </script>

    <!-- Trust badges -->
    <div class="mt-12 flex flex-wrap items-center justify-center gap-6 text-sm text-gray-400 reveal">
      {[
        { icon: '🔒', text: lang === 'ar' ? 'بيانات آمنة' : lang === 'ru' ? 'Безопасность данных' : 'Secure data' },
        { icon: '🚀', text: lang === 'ar' ? 'إعداد خلال 30 دقيقة' : lang === 'ru' ? 'Запуск за 30 минут' : 'Setup in 30 min' },
        { icon: '💳', text: lang === 'ar' ? 'بدون بطاقة ائتمان' : lang === 'ru' ? 'Без карты' : 'No credit card' },
        { icon: '🎯', text: lang === 'ar' ? 'إلغاء في أي وقت' : lang === 'ru' ? 'Отмена в любой момент' : 'Cancel anytime' },
      ].map(({ icon, text }) => (
        <div class="flex items-center gap-1.5">
          <span>{icon}</span>
          <span>{text}</span>
        </div>
      ))}
    </div>
  </div>
</section>
